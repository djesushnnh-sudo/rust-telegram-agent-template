# Development Environment Configuration
# This file is loaded when DEPLOY_ENV=dev (default)

# Development logging (more verbose)
RUST_LOG=debug

# AI disabled by default in development
AI_ENABLED=false

# Development database (local SQLite file)
DATABASE_URL=sqlite:./dev_bot_database.db

# Development webhook (usually empty for polling)
BOT_WEBHOOK_URL=

# Development port
BOT_PORT=8080

# Development deployment environment
DEPLOY_ENV=dev