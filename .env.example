# Environment Configuration for Telegram Bot Template
# Copy this file to .env and customize the values for your bot

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Telegram Bot Token (REQUIRED)
# Get this from @BotFather on Telegram by creating a new bot
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Keep this secret and never commit it to version control!
TELEGRAM_BOT_TOKEN=your_bot_token_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging level - controls how much information is logged
# Options: debug, info, warn, error
# - debug: Very detailed logging (use for development)
# - info: General information (recommended for production)
# - warn: Only warnings and errors
# - error: Only errors
RUST_LOG=info

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Webhook configuration (optional - leave empty for polling mode)
# Polling mode: Bot actively requests updates from Telegram (recommended for development)
# Webhook mode: Telegram sends updates to your server (recommended for production)
BOT_WEBHOOK_URL=

# Port for webhook server (only used if webhook URL is set)
# Must be 1024 or higher for security reasons
BOT_PORT=8080

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Note: This template uses a single .env file for simplicity
# Copy this file to .env and customize the values for your bot

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# AI functionality toggle
# Set to true when you're ready to integrate AI features
# Requires additional configuration (API keys, etc.)
AI_ENABLED=false

# Custom feature flags (uncomment and modify as needed)
# ENABLE_WEATHER=true
# ENABLE_USER_TRACKING=false
# ENABLE_ANALYTICS=true
# ENABLE_DATABASE=false
# ENABLE_RATE_LIMITING=true

# =============================================================================
# EXTERNAL API CONFIGURATION (Optional)
# =============================================================================

# Add your API keys here when integrating external services
# Uncomment the ones you need:

# Weather service API key (for weather commands)
# Get from: https://openweathermap.org/api
# WEATHER_API_KEY=your_openweather_api_key

# OpenAI API key (for AI chat features)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude API key (alternative AI service)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key

# =============================================================================
# DATABASE CONFIGURATION (OPTIONAL)
# =============================================================================

# The bot works perfectly without a database! 
# By default, the bot runs in memory-only mode.
# Uncomment and configure these options if you want persistent storage.

# Database provider type (optional - will be inferred from DATABASE_URL if not set)
# Options:
# - sqlite: SQLite database (good for most use cases, data persists across restarts)
# - memory: In-memory storage (for testing, data lost on restart)
# - none: No database (default, disables all persistence)
# DATABASE_PROVIDER=none

# Database URL for persistent storage (optional)
# Leave commented out to run without a database (recommended for getting started)
# Format depends on the provider:
# SQLite examples:
#   sqlite:./bot_database.db (local file)
#   sqlite:bot.db (simple filename)
# Memory examples:
#   memory: (in-memory storage)
#   mem: (shorthand)
# No database:
#   none: (disable database - this is the default)
#   noop: (shorthand)
# DATABASE_URL=sqlite:./bot_database.db

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================

# Enable rate limiting to prevent spam
# RATE_LIMIT_ENABLED=true

# Maximum messages per minute per user
# RATE_LIMIT_MESSAGES_PER_MINUTE=10

# Rate limit window in seconds
# RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# LOCALIZATION (Optional)
# =============================================================================

# Default language for bot responses
# DEFAULT_LANGUAGE=en

# Timezone for date/time operations
# TIMEZONE=UTC

# =============================================================================
# SECURITY CONFIGURATION (Optional)
# =============================================================================

# Allowed user IDs (comma-separated, empty = allow all)
# ALLOWED_USERS=

# Admin user IDs (comma-separated, for admin commands)
# ADMIN_USERS=

# Maximum message length to process
# MAX_MESSAGE_LENGTH=4000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable development mode (more verbose logging, debug features)
# DEV_MODE=false

# Mock external APIs for testing (when true, uses fake responses)
# MOCK_EXTERNAL_APIS=false

# =============================================================================
# MONITORING AND ANALYTICS (Optional)
# =============================================================================

# Enable usage analytics
# ENABLE_ANALYTICS=false

# Metrics collection endpoint
# METRICS_ENDPOINT=

# Health check endpoint port
# HEALTH_CHECK_PORT=8081

# =============================================================================
# NOTES
# =============================================================================

# 1. Lines starting with # are comments and are ignored
# 2. Remove the # at the beginning of a line to enable that setting
# 3. Never commit your actual .env file to version control
# 4. Use strong, unique values for API keys and tokens
# 5. Restart the bot after changing configuration values
# 6. See docs/SETUP.md for detailed configuration instructions