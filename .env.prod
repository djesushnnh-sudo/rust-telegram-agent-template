# Production Environment Configuration
# This file is loaded when DEPLOY_ENV=prod

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Production logging (less verbose)
RUST_LOG=info

# AI can be enabled in production
AI_ENABLED=false

# Production database
DATABASE_URL=sqlite:./prod_bot_database.db

# Production webhook (set your actual webhook URL)
BOT_WEBHOOK_URL=

# Production port
BOT_PORT=8080

# Production deployment environment
DEPLOY_ENV=prod